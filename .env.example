# Frontend (Nuxt). Usa NUXT_PORT para no chocar con el puerto del backend.
NUXT_PORT=9000

# Backend API (API_PORT solo aplica a localhost; en prod no se concatena)
API_URL=http://127.0.0.1
API_PORT=8020

# Opcional: URL completa del backend (tiene prioridad sobre API_URL + API_PORT)
# NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8020

# Endpoints de autenticación (relativos a apiBaseUrl)
NUXT_PUBLIC_API_AUTH_PATH=/api/auth/login/
NUXT_PUBLIC_API_AUTH_LOGOUT_PATH=/api/auth/logout/

# Firebase (config web pública: Consola de Firebase > Configuración del proyecto > Tus apps > App web)
# Si están vacías, el botón "Continuar con Google" no se muestra.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
# NUXT_PUBLIC_API_FIREBASE_AUTH_PATH=/api/auth/firebase/
